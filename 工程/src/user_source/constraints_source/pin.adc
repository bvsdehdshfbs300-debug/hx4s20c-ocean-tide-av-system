# ============================================================
# 2026-10-02  IO verification test build - new pin assignments
# Source: board schematic, sheet 2_FPGA.pdf, U70 pin -> net table
# NOTE: keep this file ASCII-only; comments are in English on purpose.
# ============================================================
# 4th push button: B1 = KEY_3  (never declared before in this design)
set_pin_assignment	{ key3 }	{ LOCATION = B1; IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }

# 4-bit DIP switch: C8/C7/C6/C5 = SWKEY_1..SWKEY_4
# PULLTYPE = NONE on purpose: let the on-board 10K resistor networks
# (RN18/RN19) define the level, so we measure the REAL board behaviour.
# An internal pull-up would mask the true polarity.
set_pin_assignment	{ dip[0] }	{ LOCATION = C8; IOSTANDARD = LVCMOS33; PULLTYPE = NONE; }
set_pin_assignment	{ dip[1] }	{ LOCATION = C7; IOSTANDARD = LVCMOS33; PULLTYPE = NONE; }
set_pin_assignment	{ dip[2] }	{ LOCATION = C6; IOSTANDARD = LVCMOS33; PULLTYPE = NONE; }
set_pin_assignment	{ dip[3] }	{ LOCATION = C5; IOSTANDARD = LVCMOS33; PULLTYPE = NONE; }

# 7-seg digit selects, complete all 8 digits: F16/E16 = SEL0/SEL1
# (previously only SEL2..SEL7 were driven -> leftmost 2 digits were dark)
set_pin_assignment	{ seg_sel[6] }	{ LOCATION = F16; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment	{ seg_sel[7] }	{ LOCATION = E16; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
